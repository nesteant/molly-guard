{
  "name": "@mollyguard/store",
  "version": "0.3.1",
  "description": "Filesystem adapter for a MollyGuard corpus: reads and writes documents, bundles and the transition ledger.",
  "keywords": [
    "mollyguard",
    "specification",
    "knowledge-base",
    "markdown",
    "frontmatter"
  ],
  "license": "MIT",
  "author": "Anton Nesterenko",
  "homepage": "https://github.com/nesteant/molly-guard#readme",
  "bugs": "https://github.com/nesteant/molly-guard/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nesteant/molly-guard.git",
    "directory": "packages/store"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build && cp ../../LICENSE ."
  },
  "dependencies": {
    "@mollyguard/core": "^0.3.1",
    "yaml": "^2.6.1"
  }
}

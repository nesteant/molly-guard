{
  "name": "mollyguard",
  "version": "0.2.0",
  "description": "MollyGuard \u2014 specification lifecycle management from the command line.",
  "keywords": [
    "mollyguard",
    "specification",
    "knowledge-base",
    "adr",
    "agent-skills",
    "cli",
    "documentation"
  ],
  "license": "MIT",
  "author": "Anton Nesterenko",
  "homepage": "https://github.com/nesteant/molly-guard#readme",
  "bugs": "https://github.com/nesteant/molly-guard/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nesteant/molly-guard.git",
    "directory": "packages/cli"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "molly": "dist/bin.js",
    "mollyguard": "dist/bin.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && chmod +x dist/bin.js",
    "prepack": "npm run build && cp ../../LICENSE . && cp ../../README.md ."
  },
  "dependencies": {
    "@mollyguard/core": "^0.2.0",
    "@mollyguard/store": "^0.2.0",
    "@inquirer/prompts": "^8.5.2"
  }
}
